// Prisma schema for Fortress Fund
// Keep financial amounts integer-only in minor units (kobo/cents); never use Decimal for ledger money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVESTOR @map("USER")
  PORTFOLIO_MANAGER
  TREASURY_MANAGER
  COMPLIANCE_OFFICER @map("COMPLIANCE")
  SUPER_ADMIN @map("ADMIN")

  @@map("Role")
}

enum KYCStatus {
  PENDING
  UNDER_REVIEW @map("IN_REVIEW")
  APPROVED
  REJECTED
}

enum KYCLevel {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  INVESTMENT_PURCHASE
  REDEMPTION
  ADJUSTMENT
  FEE
  INVESTMENT
  DIVESTMENT
  EXCHANGE
}

enum TransferStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String
  role           UserRole            @default(INVESTOR)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  profile        UserProfile?
  sessions       Session[]
  refreshTokens  RefreshToken[]
  kycRecords     KYCRecord[]
  ledgerAccounts UserLedgerAccount[]
  transactions   Transaction[]
  auditLogs      AuditLog[]
  journalEntriesCreated JournalEntry[] @relation("JournalEntryCreator")

  transfersSent     Transfer[] @relation("TransferSourceUser")
  transfersReceived Transfer[] @relation("TransferDestinationUser")
}

model UserProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  firstName      String?
  lastName       String?
  phone          String?
  dateOfBirth    DateTime?
  country        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("Profile")
}

model Session {
  id             String      @id @default(cuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id             String      @id @default(cuid())
  userId         String
  sessionId      String?
  tokenHash      String      @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model KYCRecord {
  id                  String      @id @default(cuid())
  userId              String
  status              KYCStatus   @default(PENDING)
  level               KYCLevel    @default(TIER_0)
  documentType        String?
  documentNumber      String?
  documentCountry     String?
  documentFrontUrl    String?
  documentBackUrl     String?
  metadata            Json?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewerId          String?
  reviewNotes         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([level])
}

model Account {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  type            AccountType
  normalBalance   Direction
  parentId        String?
  parent          Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]           @relation("AccountHierarchy")
  isActive        Boolean             @default(true)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  journalLines    JournalLine[]
  ledgerAccounts  UserLedgerAccount[]

  @@index([parentId])
  @@index([type])
}

model UserLedgerAccount {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  currency    String   @default("NGN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([userId, accountId, currency])
  @@index([userId, currency, isActive])
  @@index([accountId, currency, isActive])
}

model JournalEntry {
  id              String        @id @default(cuid())
  idempotencyKey  String        @unique
  reference       String        @unique
  description     String
  currency        String
  status          EntryStatus   @default(DRAFT)
  metadata        Json?
  postedAt        DateTime
  reversalOfId    String?       @unique
  reversedById    String?       @unique
  createdByUserId String?
  createdAt       DateTime      @default(now())

  lines           JournalLine[]
  transactions    Transaction[]
  transfers       Transfer[]
  createdByUser   User?         @relation("JournalEntryCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversalOf      JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       JournalEntry[] @relation("EntryReversal")
  reversedBy      JournalEntry? @relation("EntryReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)
  reversedEntries JournalEntry[] @relation("EntryReversedBy")

  @@index([status, createdAt])
  @@index([currency, status, createdAt])
  @@index([createdByUserId])
}

model JournalLine {
  id             String     @id @default(cuid())
  journalEntryId String
  accountId      String
  currency       String     @default("NGN")
  direction      Direction
  amountKobo     BigInt
  description    String?
  metadata       Json?
  createdAt      DateTime   @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([journalEntryId])
  @@index([currency, createdAt])
}

model Transaction {
  id             String            @id @default(cuid())
  userId         String
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amountKobo     BigInt
  currency       String            @default("NGN")
  reference      String            @unique
  idempotencyKey String            @unique
  journalEntryId String?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  completedAt    DateTime?

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([createdAt])
}

model Transfer {
  id                 String         @id @default(cuid())
  idempotencyKey     String         @unique
  sourceUserId       String
  destinationUserId  String
  status             TransferStatus @default(PENDING)
  amountKobo         BigInt
  currency           String         @default("NGN")
  reference          String         @unique
  journalEntryId     String?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  completedAt        DateTime?

  sourceUser         User          @relation("TransferSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  destinationUser    User          @relation("TransferDestinationUser", fields: [destinationUserId], references: [id], onDelete: Restrict)
  journalEntry       JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@index([sourceUserId, createdAt])
  @@index([destinationUserId, createdAt])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AuditEvent {
  id           String   @id @default(cuid())
  sequence     BigInt   @unique @default(autoincrement())
  actorUserId  String?
  actorRole    String?
  eventType    String
  entityType   String
  entityId     String
  payload      Json
  previousHash String?
  hash         String
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
}
