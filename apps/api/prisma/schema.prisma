// Prisma schema for Fortress Fund
// Keep financial amounts integer-only in minor units (kobo/cents); never use Decimal for ledger money.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  INVESTOR
  PORTFOLIO_MANAGER
  TREASURY_MANAGER
  COMPLIANCE_OFFICER
  SUPER_ADMIN
}

enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
  UNDER_REVIEW
}

enum KYCLevel {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  FEE
  INVESTMENT
  DIVESTMENT
  EXCHANGE
}

model User {
  id             String              @id @default(cuid())
  email          String              @unique
  passwordHash   String
  role           UserRole            @default(INVESTOR)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  profile        UserProfile?
  sessions       Session[]
  refreshTokens  RefreshToken[]
  kycRecords     KYCRecord[]
  ledgerAccounts UserLedgerAccount[]

  transfersSent     Transfer[] @relation("TransferSourceUser")
  transfersReceived Transfer[] @relation("TransferDestinationUser")

  walletTransactions WalletTransaction[] @relation("WalletUser")
  approvedWalletTx   WalletTransaction[] @relation("WalletApprover")
}

model UserProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  firstName      String?
  lastName       String?
  phone          String?
  dateOfBirth    DateTime?
  country        String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id             String      @id @default(cuid())
  userId         String
  ipAddress      String?
  userAgent      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id             String      @id @default(cuid())
  userId         String
  sessionId      String?
  tokenHash      String      @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  createdAt      DateTime    @default(now())

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model KYCRecord {
  id                  String      @id @default(cuid())
  userId              String
  status              KYCStatus   @default(PENDING)
  level               KYCLevel    @default(TIER_0)
  documentType        String?
  documentNumber      String?
  documentCountry     String?
  documentFrontUrl    String?
  documentBackUrl     String?
  metadata            Json?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewerId          String?
  reviewNotes         String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([level])
}

model Account {
  id              String              @id @default(cuid())
  code            String              @unique
  name            String
  type            AccountType
  normalBalance   Direction
  parentId        String?
  parent          Account?            @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        Account[]           @relation("AccountHierarchy")
  isActive        Boolean             @default(true)
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  journalLines    JournalLine[]
  ledgerAccounts  UserLedgerAccount[]

  @@index([parentId])
  @@index([type])
}

model UserLedgerAccount {
  id          String   @id @default(cuid())
  userId      String
  accountId   String
  currency    String   @default("NGN")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([userId, accountId, currency])
  @@index([userId, currency, isActive])
  @@index([accountId, currency, isActive])
}

model JournalEntry {
  id              String        @id @default(cuid())
  idempotencyKey  String        @unique
  reference       String        @unique
  description     String
  currency        String
  status          EntryStatus   @default(DRAFT)
  metadata        Json?
  postedAt        DateTime?
  reversedAt      DateTime?
  reversalOfId    String?       @unique
  reversedById    String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lines           JournalLine[]

  reversalOf      JournalEntry? @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy      JournalEntry? @relation("EntryReversedBy", fields: [reversedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([currency, status, createdAt])
}

model JournalLine {
  id             String     @id @default(cuid())
  journalEntryId String
  accountId      String
  direction      Direction
  amountKobo     BigInt
  metadata       Json?
  createdAt      DateTime   @default(now())

  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([journalEntryId])
}

model Transfer {
  id                 String            @id @default(cuid())
  idempotencyKey     String            @unique
  sourceUserId       String
  destinationUserId  String
  amountKobo         BigInt
  currency           String
  status             TransactionStatus @default(PENDING)
  reference          String            @unique
  description        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  sourceUser         User              @relation("TransferSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  destinationUser    User              @relation("TransferDestinationUser", fields: [destinationUserId], references: [id], onDelete: Restrict)

  @@index([sourceUserId, createdAt])
  @@index([destinationUserId, createdAt])
  @@index([status, createdAt])
}

model WalletTransaction {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  userId         String
  type           TransactionType
  amountKobo     BigInt
  currency       String
  status         TransactionStatus @default(PENDING)
  reference      String            @unique
  description    String?
  metadata       Json?
  approvedById   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user       User  @relation("WalletUser", fields: [userId], references: [id], onDelete: Restrict)
  approvedBy User? @relation("WalletApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
