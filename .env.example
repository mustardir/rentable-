# ============================================================
# Fortress Fund Production Environment
# Copy to .env and replace every change_me_* value.
# NEVER commit the real .env file.
# ============================================================

NODE_ENV=production

APP_DOMAIN=fortress-fund.com
APP_URL=https://fortress-fund.com

NEXT_PUBLIC_APP_URL=https://fortress-fund.com
NEXT_PUBLIC_API_URL=https://fortress-fund.com/api

CORS_ORIGIN=https://fortress-fund.com

POSTGRES_DB=fortress_fund
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres

DATABASE_URL=postgresql://postgres:change_me_postgres@postgres:5432/fortress_fund

REDIS_PASSWORD=change_me_redis
REDIS_URL=redis://:change_me_redis@redis:6379

JWT_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

PROMETHEUS_ENABLED=false

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

GRAFANA_ROOT_URL=https://fortress-fund.com/grafana/
