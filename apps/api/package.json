{
  "name": "@fortress-fund/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fortress Fund NestJS API",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "test": "cross-env NODE_ENV=test jest --runInBand --testPathIgnorePatterns=financial-product\\.defaults\\.spec\\.ts --testPathIgnorePatterns=financial-product\\.service\\.spec\\.ts --testPathIgnorePatterns=document-core\\.docx\\.spec\\.ts --testPathIgnorePatterns=document-template\\.pipeline\\.spec\\.ts",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.8",
    "@nestjs/core": "^10.4.8",
    "@nestjs/platform-express": "^10.4.8",
    "@prisma/client": "^5.22.0",
    "@fortress/audit-core": "workspace:*",
    "@fortress/document-core": "workspace:*",
    "@fortress/ledger-core": "workspace:*",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^11.0.5",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "jsonwebtoken": "^9.0.0",
    "express": "^4.21.2",
    "class-validator": "^0.14.0",
    "class-transformer": "^0.5.1",
    "bcryptjs": "^2.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "cross-env": "^7.0.3",
    "supertest": "^6.3.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.8",
    "@types/node": "^22.10.5",
    "@types/express": "^5.0.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "jest": "^29.6.1",
    "ts-jest": "^29.1.0",
    "@types/jest": "^29.5.3",
    "@types/supertest": "^2.0.12",
    "vitest": "3.2.6"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
