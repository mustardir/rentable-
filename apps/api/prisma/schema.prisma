generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  COMPLIANCE
}

enum KYCStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum KYCLevel {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum Direction {
  DEBIT
  CREDIT
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  INVESTMENT_PURCHASE
  REDEMPTION
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

enum TransferStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role Role @default(USER)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profile Profile?
  sessions Session[]
  refreshTokens RefreshToken[]
  kycRecords KYCRecord[]
  auditLogs AuditLog[]
  journalEntries JournalEntry[] @relation("JournalEntryCreatedBy")
  transactions Transaction[]
  transfersSent Transfer[] @relation("TransferSourceUser")
  transfersReceived Transfer[] @relation("TransferDestinationUser")
  ledgerAccounts UserLedgerAccount[]
}

model Profile {
  id String @id @default(cuid())
  userId String @unique
  firstName String?
  lastName String?
  phone String?
  dateOfBirth DateTime?
  country String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id String @id @default(cuid())
  userId String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id String @id @default(cuid())
  userId String
  sessionId String?
  tokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model KYCRecord {
  id String @id @default(cuid())
  userId String
  status KYCStatus @default(PENDING)
  level KYCLevel @default(TIER_0)
  documentType String?
  documentNumber String?
  documentCountry String?
  documentFrontUrl String?
  documentBackUrl String?
  metadata Json?
  submittedAt DateTime?
  reviewedAt DateTime?
  reviewerId String?
  reviewNotes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
  @@index([level])
}

model Account {
  id String @id @default(cuid())
  code String @unique
  name String
  type AccountType
  normalBalance Direction
  parentId String?
  parent Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")
  isActive Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  journalLines JournalLine[]
  ledgerAccounts UserLedgerAccount[]
  @@index([parentId])
  @@index([type])
}

model UserLedgerAccount {
  id String @id @default(cuid())
  userId String
  accountId String
  currency String @default("NGN")
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([userId, accountId])
  @@index([userId, isActive])
  @@index([accountId, isActive])
}

model JournalEntry {
  id String @id @default(cuid())
  idempotencyKey String @unique
  reference String @unique
  description String
  currency String @default("NGN")
  status EntryStatus @default(POSTED)
  postedAt DateTime
  reversalOfId String?
  reversedById String?
  metadata Json?
  createdAt DateTime @default(now())
  createdByUserId String?
  lines JournalLine[]
  createdByUser User? @relation("JournalEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reversalOf JournalEntry? @relation("JournalEntryReversalOf", fields: [reversalOfId], references: [id])
  reversals JournalEntry[] @relation("JournalEntryReversalOf")
  reversedBy JournalEntry? @relation("JournalEntryReversedBy", fields: [reversedById], references: [id])
  reversedEntries JournalEntry[] @relation("JournalEntryReversedBy")
  transactions Transaction[]
  transfers Transfer[]
  @@index([status])
  @@index([postedAt])
  @@index([createdByUserId])
}

model JournalLine {
  id String @id @default(cuid())
  journalEntryId String
  accountId String
  direction Direction
  amountKobo BigInt
  description String?
  metadata Json?
  createdAt DateTime @default(now())
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([journalEntryId])
  @@index([accountId])
  @@index([createdAt])
}

model Transaction {
  id String @id @default(cuid())
  userId String
  type TransactionType
  status TransactionStatus @default(PENDING)
  amountKobo BigInt
  currency String @default("NGN")
  reference String @unique
  idempotencyKey String @unique
  journalEntryId String?
  failureReason String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  @@index([userId, status])
  @@index([createdAt])
}

model Transfer {
  id String @id @default(cuid())
  sourceUserId String
  destinationUserId String
  status TransferStatus @default(PENDING)
  amountKobo BigInt
  currency String @default("NGN")
  reference String @unique
  idempotencyKey String @unique
  journalEntryId String?
  failureReason String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  completedAt DateTime?
  sourceUser User @relation("TransferSourceUser", fields: [sourceUserId], references: [id], onDelete: Restrict)
  destinationUser User @relation("TransferDestinationUser", fields: [destinationUserId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id])
  @@index([sourceUserId, status])
  @@index([destinationUserId, status])
  @@index([createdAt])
}

model WalletBalanceCache {
  investorId String @id
  availableKobo BigInt
  currency String @default("NGN")
  lastJournalLineId String
  rebuiltAt DateTime @updatedAt
}

model AuditEvent {
  id String @id @default(cuid())
  sequence BigInt @default(autoincrement())
  actorUserId String?
  actorRole String?
  eventType String
  entityType String
  entityId String
  payload Json
  previousHash String?
  hash String
  createdAt DateTime @default(now())
  @@index([entityType, entityId])
  @@index([eventType])
  @@index([createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  userId String?
  action String
  entityType String
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
